# Strict By-Reference Provenance & Numeric Citation Reconciliation Gate
# Inspired by Human Protein Atlas v26 / AtlasAI (no-retype + source-record verification)

numeric_provenance:
  contract_id: "hpa_v26_trem2_microglia_reconciliation_01"
  provenance_binding: "strict_reference"
  require_reconciliation: true
  source_records:
    HPA_ENSG00000095977_RNA:
      microglia_ntpm: 142.8
      brain_consensus_ntpm: 38.4
    HPA_ENSG00000095977_PROTEIN:
      ihc_microglia_score: 3.0
  cited_claims:
    - claim_id: "trem2_microglia_rna_level"
      metric_key: "microglia_ntpm"
      declared_value: 142.8
      source_record_id: "HPA_ENSG00000095977_RNA"
      artifact_ref:
        step_id: "hpa_rna_query_01"
        output_key: "microglia_ntpm"
        source_record_id: "HPA_ENSG00000095977_RNA"
      tolerance: 1e-6
    - claim_id: "trem2_brain_consensus_rna"
      metric_key: "brain_consensus_ntpm"
      declared_value: 38.4
      source_record_id: "HPA_ENSG00000095977_RNA"
      artifact_ref: "${hpa_rna_query_01.brain_consensus_ntpm}"
      tolerance: 1e-6
    - claim_id: "trem2_protein_ihc"
      metric_key: "ihc_microglia_score"
      declared_value: 3.0
      source_record_id: "HPA_ENSG00000095977_PROTEIN"
      artifact_ref:
        step_id: "hpa_protein_query_02"
        output_key: "ihc_microglia_score"
        source_record_id: "HPA_ENSG00000095977_PROTEIN"
      tolerance: 1e-6
