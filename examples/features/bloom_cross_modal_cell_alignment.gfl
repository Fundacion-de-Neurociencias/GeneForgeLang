# Bloom-Inspired Cross-Modal Cell Alignment Contract
# Connects scRNA-seq and Patch-seq electrophysiology studies into a shared taxonomy.

cell_alignment:
  contract_id: "bloom_mouse_cortex_bridge_01"
  bridge_model: "bloom_multiome_bridge_v1"
  bridge_species: "Mus musculus"
  bridge_modalities:
    - "scrna_seq"
    - "scatac_seq"
  reference_taxonomy: "allen_brain_cell_atlas"
  min_mapping_confidence: 0.75
  max_unmapped_fraction: 0.15
  observed_unmapped_fraction: 0.06
  min_genes_per_cell: 800
  min_gene_peak_attention: 0.35
  allow_cross_species_transfer: false
  anchor_cell_types:
    - "CL:0000127"
    - "L5_IT_CTX"
  studies:
    - study_id: "study_scrna_cortex"
      modality: "scrna_seq"
      species: "Mus musculus"
      cell_count: 18500
      observed_median_genes: 2400
    - study_id: "study_ephys_patch"
      modality: "electrophysiology"
      species: "Mus musculus"
      cell_count: 1420
      observed_median_genes: 1150
  mappings:
    - source_study_id: "study_ephys_patch"
      target_study_id: "study_scrna_cortex"
      source_label: "fast_spiking_basket"
      target_label: "Pvalb_Gaba"
      taxonomy_curie: "CL:0000127"
      mapping_confidence: 0.91
      is_anchor: true
      artifact_ref: "${bloom_align.pvalb_transfer}"
    - source_study_id: "study_ephys_patch"
      target_study_id: "study_scrna_cortex"
      source_label: "thick_tufted_pyramidal"
      target_label: "L5_IT_CTX"
      taxonomy_curie: "CL:0000679"
      mapping_confidence: 0.84
      is_anchor: false
      artifact_ref: "${bloom_align.l5_it_transfer}"
  gene_peak_links:
    - gene_symbol: "PVALB"
      peak_region: "chr22:36801200-36801950"
      target_cell_type: "CL:0000127"
      attention_weight: 0.78
      selective_access_candidate: true
      ag2_link_ref: "ag2_pvalb_enhancer_01"
      artifact_ref: "${bloom_align.pvalb_enhancer_attn}"
