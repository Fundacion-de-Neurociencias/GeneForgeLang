#!/bin/bash
# Pre-push hook personalizado - NeuroIA Protocol

while read local_ref local_oid remote_ref remote_oid
do
    if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/master" ]]; then
        echo "❌ ERROR (NEUROIA PROTOCOL): PUSH DIRECTO A MAIN BLOQUEADO."
        exit 1
    fi
done
