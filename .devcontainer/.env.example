# Environment variables used by GeneForgeLang tools. Names only: never commit values.
# Copy this file to .env and fill in the values locally. .env is ignored by git.
# load_dotenv() reads .env from the current working directory, so place the copy
# where you launch the app (usually the repository root).

# Google Generative AI key for the GFL translator apps
# (src/geneforgelang/web/apps/translator_app/app.py, resources/tools/dev/gfl_translator_app.py).
GOOGLE_API_KEY=

# Import path inside the dev container (.devcontainer/run-tests.sh sets /workspace).
PYTHONPATH=

# Runtime environment label used by the dev-container test scripts (for example: test).
GFL_ENV=
